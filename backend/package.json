{
  "name": "gb-cas-sell-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST modular para flujo SELL USDT TRC20 por COP orientado a integración futura con GENERAL BYTES CAS.",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/app/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "orders:migrate-deposit-index": "node --import tsx src/scripts/migrate-order-deposit-index.ts",
    "locks:migrate-indexes": "tsx src/scripts/migrate-distributed-lock-indexes.ts",
    "storage:analyze": "tsx src/scripts/storage-analyze.ts",
    "storage:retention": "tsx src/scripts/storage-retention.ts",
    "itrx:disable-buy-smart-delegate": "tsx src/scripts/disable-buy-smart-delegate.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "mongodb-memory-server": "^11.0.1",
    "nock": "^14.0.11",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@types/pdfkit": "^0.17.5",
    "argon2": "^0.44.0",
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "fastify-raw-body": "^5.0.0",
    "mongodb": "^7.1.1",
    "mongoose": "^9.3.3",
    "otplib": "^13.4.0",
    "pdfkit": "^0.18.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "ulid": "^3.0.2",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.1"
  }
}
